#include <winver.h>

1 VERSIONINFO
 FILEVERSION @WK_WINDOWS_UPDATER_RESOURCE_VERSION_MAJOR@,@WK_WINDOWS_UPDATER_RESOURCE_VERSION_MINOR@,@WK_WINDOWS_UPDATER_RESOURCE_VERSION_PATCH@,0
 PRODUCTVERSION @WK_WINDOWS_UPDATER_RESOURCE_VERSION_MAJOR@,@WK_WINDOWS_UPDATER_RESOURCE_VERSION_MINOR@,@WK_WINDOWS_UPDATER_RESOURCE_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@WK_WINDOWS_UPDATER_RESOURCE_MANUFACTURER@\0"
            VALUE "FileDescription", "@WK_WINDOWS_UPDATER_RESOURCE_PRODUCT@ Updater\0"
            VALUE "FileVersion", "@WK_WINDOWS_UPDATER_RESOURCE_VERSION@\0"
            VALUE "InternalName", "@WK_WINDOWS_UPDATER_RESOURCE_PRODUCT@Updater\0"
            VALUE "OriginalFilename", "@WK_WINDOWS_UPDATER_RESOURCE_PRODUCT@Updater.exe\0"
            VALUE "ProductName", "@WK_WINDOWS_UPDATER_RESOURCE_PRODUCT@\0"
            VALUE "ProductVersion", "@WK_WINDOWS_UPDATER_RESOURCE_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
